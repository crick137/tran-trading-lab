{
  "crons": [
    {
      "path": "/api/cron/publish-news",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/whale-alerts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/economic-calendar",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/fear-greed-index",
      "schedule": "0 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}