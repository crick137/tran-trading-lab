{
  "crons": [
    {
      "path": "/api/cron/publish-news",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/morning-briefing",
      "schedule": "0 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}