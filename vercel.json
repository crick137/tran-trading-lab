{
  "crons": [
    {
      "path": "/api/cron/publish-news",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/morning-briefing",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/evening-summary",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/price-alerts",
      "schedule": "0 0,12 * * *"
    },
    {
      "path": "/api/cron/whale-alerts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 1 * * 0"
    },
    {
      "path": "/api/cron/economic-calendar",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/technical-analysis",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-trading-tip",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/news-analysis",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/market-sentiment-card",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-market-story",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/trading-psychology-quiz",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/curated-article",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/news-commentary",
      "schedule": "0 */4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}