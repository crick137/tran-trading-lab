{
    "framework": "nextjs",
    "crons": [
        {
            "path": "/api/cron/publish-news",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/publish-news-en",
            "schedule": "30 * * * *"
        },
        {
            "path": "/api/cron/economic-calendar",
            "schedule": "30 22 * * *"
        },
        {
            "path": "/api/cron/economic-calendar-en",
            "schedule": "0 23 * * *"
        },
        {
            "path": "/api/cron/daily-summary",
            "schedule": "0 11 * * *"
        },
        {
            "path": "/api/cron/daily-summary-en",
            "schedule": "30 11 * * *"
        },
        {
            "path": "/api/cron/weekly-report",
            "schedule": "0 11 * * 0"
        },
        {
            "path": "/api/cron/weekly-report-en",
            "schedule": "30 11 * * 0"
        },
        {
            "path": "/api/cron/whale-alerts",
            "schedule": "0 */6 * * *"
        },
        {
            "path": "/api/cron/whale-alerts-en",
            "schedule": "30 */6 * * *"
        },
        {
            "path": "/api/cron/volatility-alert",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/volatility-alert-en",
            "schedule": "30 * * * *"
        }
    ]
}