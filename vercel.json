{
    "crons":  [
                  {
                      "path":  "/api/cron/publish-news",
                      "schedule":  "0 * * * *"
                  },
                  {
                      "path":  "/api/cron/whale-alerts",
                      "schedule":  "0 3 * * *"
                  },
                  {
                      "path":  "/api/cron/economic-calendar",
                      "schedule":  "30 22 * * *"
                  },
                  {
                      "path":  "/api/cron/fear-greed-index",
                      "schedule":  "0 23 * * *"
                  },
                  {
                      "path":  "/api/cron/market-report",
                      "schedule":  "0 8 * * *"
                  },
                  {
                      "path":  "/api/cron/price-alert",
                      "schedule":  "0 */4 * * *"
                  },
                  {
                      "path":  "/api/cron/weekly-report",
                      "schedule":  "0 20 * * 0"
                  }
              ],
    "rewrites":  [
                     {
                         "source":  "/api/(.*)",
                         "destination":  "/api/$1"
                     },
                     {
                         "source":  "/((?!api/).*)",
                         "destination":  "/index.html"
                     }
                 ]
}
