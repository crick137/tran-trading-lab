# Environment Variables for TRAN Trading Lab

# ============================================
# Supabase Configuration (Already configured)
# ============================================
SUPABASE_URL=https://pikvpypivivzhmoyeipd.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# Email Service (Gmail SMTP)
# ============================================
# 用于发送验证邮件、密码重置邮件等
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=izuowangdaozi@gmail.com
SMTP_PASS=your_app_password_here

# 注意: Gmail需要使用应用专用密码
# 1. 开启Google账户两步验证
# 2. 访问 https://myaccount.google.com/apppasswords
# 3. 创建应用专用密码
# 4. 将密码填入上方 SMTP_PASS

# ============================================
# AI Configuration (Optional)
# ============================================
# Groq API Key (FREE - Get yours at: https://console.groq.com)
# 或使用内置智能响应系统（无需API Key）
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# App Configuration
# ============================================
APP_URL=http://localhost:5173
NODE_ENV=development

# ============================================
# Proxy Server
# ============================================
PORT=3001
CORS_ORIGIN=*
